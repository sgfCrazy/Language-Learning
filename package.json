{
  "name": "language-learning",
  "version": "0.1.0",
  "private": true,
  "description": "句乐部风格英语学习平台（Web + 微信小程序）",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "pnpm -F @app/server dev",
    "dev:web": "pnpm -F @app/web-taro dev:h5",
    "dev:weapp": "pnpm -F @app/web-taro dev:weapp",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm -F @app/server seed",
    "db:migrate": "pnpm -F @app/server prisma:migrate",
    "e2e": "pnpm -F @app/web-taro e2e"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
