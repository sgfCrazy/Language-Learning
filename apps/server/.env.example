# 后端环境变量（开发示例）。复制为 .env 并填入真实值。切勿提交 .env。
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/language_learning?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d

# 微信小程序
WX_APPID=your-miniapp-appid
WX_SECRET=your-miniapp-secret

# 微信网页扫码
WX_WEB_APPID=your-web-appid
WX_WEB_SECRET=your-web-secret
WX_WEB_REDIRECT=http://localhost:3000/api/v1/auth/wx/callback

# LLM（后续 ai-assistant 用）
LLM_PROVIDER=glm
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
